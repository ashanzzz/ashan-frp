<?xml version="1.0"?>
<Container version="2">
  <Name>ashan-frp</Name>
  <Repository>ghcr.io/ashanzzz/ashan-frp:latest</Repository>
  <Registry>https://ghcr.io</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/ashanzzz/ashan-frp/issues</Support>
  <Project>https://github.com/ashanzzz/ashan-frp</Project>
  <Overview>Go-based FRP management plane with embedded UI served by the backend. Single-container deployment, Docker-friendly, and designed for Unraid.</Overview>
  <Category>Network: Status:Stable</Category>
  <WebUI>http://[IP]:[PORT:8080]/ui/</WebUI>
  <TemplateURL/>
  <Icon/>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled></DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="WebUI Port" Target="8080" Default="8080" Mode="tcp" Description="Web UI port" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="App Data" Target="/app/data" Default="/mnt/user/appdata/ashan-frp" Mode="rw" Description="Persistent application data" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/ashan-frp</Config>
</Container>
