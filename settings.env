# 自动化策略（按需改）
PRIMARY_DOMAIN="335356119.xyz"

# 节点筛选（all 最宽松；你也可以改成 yes/vip/带宽 等）
FILTER_CHINA="all"
FILTER_TYPE="all"
FILTER_BUILD_SITE="yes"
FILTER_NOTES=""

# 刷新节点列表周期（秒）
NODE_REFRESH_SECONDS=3600

# fastest 模式切线冷却（秒）
COOLDOWN_SECONDS=900

# 切线失败的节点 ban 时长（秒）
BAN_SECONDS=3600

# 回退尝试次数
MAX_TRIES=3
