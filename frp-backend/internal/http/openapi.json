    "/settings/integrations/cloudflare/configure": {
      "post": {
        "summary": "Auto-detect, verify, and atomically save a Cloudflare API Token or Global API Key",
        "description": "API Tokens are tested with Bearer authentication. Global API Keys use X-Auth-Email and X-Auth-Key. A single accessible zone is verified and saved automatically; multiple zones return zone_selection_required until zone_id is submitted.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "secret"
                ],
                "properties": {
                  "secret": {
                    "type": "string",
                    "description": "Cloudflare API Token or Global API Key"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Required for Global API Key authentication"
                  },
                  "zone_id": {
                    "type": "string",
                    "description": "Selected zone when discovery returns more than one zone"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Credential saved, or a safe zone_selection_required response"
          },
          "400": {
            "description": "Credential invalid, email required, no zones, inaccessible zone, or DNS read verification failed"
          },
          "500": {
            "description": "Encrypted credential transaction failed"
          }
        }
      }
    },
    "/dns/records": {
      "get": {
        "summary": "List all Cloudflare DNS records for the configured Zone",
        "responses": {
          "200": {
            "description": "DNS records",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "zone": {
                              "type": "string"
                            },
                            "total": {
                              "type": "integer"
                            },
                            "records": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/DNSRecord"
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "412": {
            "description": "Cloudflare Token or Zone has not been configured"
          },
          "502": {
            "description": "Cloudflare DNS request failed"
          }
        }
      },
      "post": {
        "summary": "Create a Cloudflare DNS record",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DNSRecordInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseEnvelope"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/DNSRecord"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid DNS record input"
          },
          "412": {
            "description": "Cloudflare Token or Zone has not been configured"
          },
          "502": {
            "description": "Cloudflare DNS request failed"
          }
        }
      }
    },
